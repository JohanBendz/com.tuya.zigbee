{
  "id": "waterdetector_ewelink",
  "name": {
    "en": "Water Detector Ewelink"
  },
  "class": "sensor",
  "platforms": ["local"],
  "connectivity": ["zigbee"],
  "capabilities": ["alarm_contact", "alarm_water", "alarm_battery"],
  "energy": {
    "batteries": ["AAA", "AAA"]
  },
  "images": {
    "large": "{{driverAssetsPath}}/images/large.png",
    "small": "{{driverAssetsPath}}/images/small.png"
  },
  "zigbee": {
    "manufacturerName": ["eWeLink"],
    "productId": ["SNZB-03"],
    "endpoints": {
      "1": {
        "clusters": [0, 1, 3, 1280],
        "bindings": [1, 1280]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Push the button for aprox 10 seconds until the LED blinks rapidly. If nothing happens; put two fingers against the detectors and repeat."
      }
    }
  }
}
