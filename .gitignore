# GITIGNORE - Tuya Zigbee Project
# Optimisé pour la communauté Homey - Exclusion des fichiers compilés

# DEPENDENCIES
node_modules/
.npm/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# BUILD FILES
dist/
build/
out/
.next/
.nuxt/
.vercel/
.homeybuild/
.homeycompose/cache/
.homeycompose/temp/

# TEMPORARY FILES
*.tmp
*.temp
*.cache
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~

# LOGS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
!auto-update.log

# ARCHIVES
*.tar.gz
*.zip
*.7z
*.rar
archives/
backup_*/
restore_*/
intelligent-backup_*/

# CACHE FILES
.eslintcache
.stylelintcache
.prettiercache
.cache/
.temp/
.tmp/

# SYSTEM FILES
.DS_Store
Thumbs.db
*.iml
.idea/
.vscode/settings.json

# DATA FILES (volumineux)
data/manufacturer_ids.json
data/manufacturer_ids_ha.json
data/manufacturer_ids_z2m.json
*.csv
*.xlsx
*.xls

# IMAGES (garder SVG)
assets/icons/*.png
assets/icons/*.jpg
assets/icons/*.jpeg
assets/images/*.png
assets/images/*.jpg
assets/images/*.jpeg
!assets/icons/*.svg
!assets/images/*.svg

# REPORTS (volumineux)
*.report.json
*.benchmark.json
*.analysis.json

# OBSOLETE DIRECTORIES
OLDVERSION/
tools/
test/
docs/

# ENVIRONMENT
.env
*.key
*.pem

# BACKUP FILES
*.backup
*.restore
.homeyplugins.json.bak
