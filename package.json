{
  "name": "com.tuya.zigbee",
  "version": "0.3.3",
  "description": "Adds support for Tuya Zigbee devices to Homey",
  "main": "app.js",
  "scripts": {
    "run": "homey app run",
    "validate": "homey app validate --level publish",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run validate",
    "update:supported-devices": "node scripts/generate-supported-devices.js",
    "check:supported-devices": "node scripts/generate-supported-devices.js --check"
  },
  "keywords": [
    "Tuya",
    "Zigbee"
  ],
  "author": "Johan Bendz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohanBendz/com.tuya.zigbee.git"
  },
  "bugs": {
    "url": "https://github.com/JohanBendz/com.tuya.zigbee/issues"
  },
  "homepage": "https://github.com/JohanBendz/com.tuya.zigbee#readme",
  "engines": {
    "node": ">=12"
  },
  "contributors": [
    "Johan Bendz <johan_bendz@hotmail.com>"
  ],
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/johanbendz"
  },
  "dependencies": {
    "homey-zigbeedriver": "2.1.4",
    "zigbee-clusters": "2.4.1"
  }
}
